@model IEnumerable<PhongsathornWebApp1.Models.Product>

@{
    ViewData["Title"] = "หน้าแรก";
}

<section class="p-4 p-md-5 mb-4 bg-light rounded-3">
    <div class="container-fluid py-2">
        <span class="badge text-bg-success mb-3">ยินดีต้อนรับสู่ PHT Store</span>
        <h1 class="display-5 fw-bold">เลือกของที่ใช่ ให้ทุกวันง่ายขึ้น</h1>
        <p class="col-md-8 fs-5 text-secondary">รวมของใช้ในชีวิตประจำวัน คัดสรรมาให้เลือกง่ายในที่เดียว</p>
        <a class="btn btn-success btn-lg" asp-controller="Product" asp-action="Index">ดูสินค้าทั้งหมด</a>
    </div>
</section>

<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
    <div>
        <h2 class="h3 mb-1">สินค้าแนะนำ</h2>
        <p class="text-secondary mb-0">เลือกดูสินค้าของเรา</p>
    </div>
    <span class="text-secondary small">แสดงหน้าละ 3 รายการ</span>
</div>

<div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-3">
    @foreach (var item in Model)
    {
        <div class="col">
            <article class="card h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="badge text-bg-light">สินค้า #@item.Id</span>
                        <span class="fs-2" aria-hidden="true">@(item.Id switch { 1 => "👜", 2 => "☕", 3 => "💡", 4 => "🎧", 5 => "⌚", 6 => "📷", _ => "🌿" })</span>
                    </div>
                    <h3 class="h5 card-title">@item.Name</h3>
                    <p class="text-secondary mb-2">คงเหลือ @item.Quantity ชิ้น</p>
                    <p class="h5 text-success mb-0">฿@item.Price.ToString("N2")</p>
                </div>
            </article>
        </div>
    }
</div>

<nav class="mt-4" aria-label="เปลี่ยนหน้าสินค้า">
    <ul class="pagination justify-content-center">
        <li class="page-item @(ViewBag.CurrentPage <= 1 ? "disabled" : "")">
            <a class="page-link" asp-controller="Home" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage - 1)">ก่อนหน้า</a>
        </li>
        @for (var pageNumber = 1; pageNumber <= (int)ViewBag.TotalPages; pageNumber++)
        {
            <li class="page-item @(pageNumber == (int)ViewBag.CurrentPage ? "active" : "")">
                <a class="page-link" asp-controller="Home" asp-action="Index" asp-route-page="@pageNumber">@pageNumber</a>
            </li>
        }
        <li class="page-item @(ViewBag.CurrentPage >= ViewBag.TotalPages ? "disabled" : "")">
            <a class="page-link" asp-controller="Home" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage + 1)">ถัดไป</a>
        </li>
    </ul>
</nav>
