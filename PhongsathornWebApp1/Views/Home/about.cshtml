@{
    ViewData["Title"] = "เกี่ยวกับเรา";
}

<section class="p-4 p-md-5 mb-4 bg-light rounded-3">
    <span class="badge text-bg-success mb-3">เกี่ยวกับ PHT Store</span>
    <h1 class="display-6 fw-bold">ร้านตัวอย่างสำหรับของใช้ในทุกวัน</h1>
    <p class="col-md-9 fs-5 text-secondary mb-0">PHT Store รวบรวมสินค้าตัวอย่างที่ใช้ได้ในชีวิตประจำวัน พร้อมแสดงราคาและจำนวนคงเหลือในรูปแบบที่ดูง่าย</p>
</section>

<div class="row row-cols-1 row-cols-md-3 g-3">
    <div class="col">
        <div class="card h-100">
            <div class="card-body">
                <span class="badge text-bg-light mb-3">01</span>
                <h2 class="h5">เลือกดูง่าย</h2>
                <p class="card-text text-secondary">ค้นหารายการสินค้าและดูข้อมูลสำคัญได้สะดวก</p>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100">
            <div class="card-body">
                <span class="badge text-bg-light mb-3">02</span>
                <h2 class="h5">ใช้งานได้ทุกหน้าจอ</h2>
                <p class="card-text text-secondary">จัดวางหน้าเว็บให้รองรับทั้งคอมพิวเตอร์และโทรศัพท์</p>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100">
            <div class="card-body">
                <span class="badge text-bg-light mb-3">03</span>
                <h2 class="h5">โปรเจกต์เพื่อการเรียนรู้</h2>
                <p class="card-text text-secondary">พัฒนาด้วย ASP.NET Core MVC และ Bootstrap</p>
            </div>
        </div>
    </div>
</div>
