@{
    ViewData["Title"] = "นโยบายความเป็นส่วนตัว";
}

<div class="mb-4">
    <span class="badge text-bg-success mb-2">ข้อมูลเว็บไซต์</span>
    <h1 class="h2">นโยบายความเป็นส่วนตัว</h1>
    <p class="text-secondary">รายละเอียดการใช้งานเว็บไซต์ PHT Store</p>
</div>

<div class="card">
    <div class="card-body p-4">
        <h2 class="h5">เว็บไซต์เพื่อการเรียนรู้</h2>
        <p class="text-secondary">เว็บไซต์นี้เป็นโปรเจกต์ตัวอย่างสำหรับฝึกพัฒนาเว็บด้วย ASP.NET Core MVC รายการสินค้าและจำนวนคงเหลือเป็นข้อมูลตัวอย่าง</p>

        <h2 class="h5 mt-4">ข้อมูลส่วนบุคคล</h2>
        <p class="text-secondary">เว็บไซต์ไม่มีระบบสมาชิก ไม่มีการชำระเงิน และไม่มีแบบฟอร์มที่ขอข้อมูลส่วนบุคคล</p>

        <h2 class="h5 mt-4">ติดต่อผู้จัดทำ</h2>
        <p class="text-secondary mb-0">หากมีคำถามเกี่ยวกับโปรเจกต์ สามารถติดต่อผู้จัดทำเว็บไซต์ได้โดยตรง</p>
    </div>
</div>
