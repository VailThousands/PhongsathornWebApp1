@model IEnumerable<Product>

@{
    ViewData["Title"] = "สินค้า";
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">สินค้าทั้งหมด</h1>
        <p class="text-secondary mb-0">ดูข้อมูลสินค้าและจำนวนคงเหลือ</p>
    </div>
    <span class="badge text-bg-success fs-6">@Model.Count() รายการ</span>
</div>

<div class="card">
    <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2 py-3">
        <h2 class="h5 mb-0">รายการสินค้า</h2>
        <div>
            <label for="productSearch" class="visually-hidden">ค้นหาสินค้า</label>
            <input id="productSearch" class="form-control" type="search" placeholder="ค้นหาชื่อสินค้า..." />
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col">รหัส</th>
                    <th scope="col">ชื่อสินค้า</th>
                    <th scope="col">ราคา</th>
                    <th scope="col">จำนวนคงเหลือ</th>
                </tr>
            </thead>
            <tbody id="productRows">
                @foreach (var product in Model)
                {
                    <tr>
                        <td>@product.Id</td>
                        <td class="product-name">@product.Name</td>
                        <td>฿@product.Price.ToString("N2")</td>
                        <td>@product.Quantity</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p id="noProductResults" class="text-secondary text-center p-3 mb-0" hidden>ไม่พบสินค้าที่ค้นหา</p>
</div>

<p class="text-secondary small mt-3">ข้อมูลสินค้าเป็นข้อมูลตัวอย่างสำหรับโปรเจกต์นี้</p>

@section Scripts {
    <script>
        const searchInput = document.getElementById('productSearch');
        const productRows = document.querySelectorAll('#productRows tr');
        const noResultsMessage = document.getElementById('noProductResults');

        searchInput.addEventListener('input', function () {
            const searchText = this.value.toLowerCase();
            let visibleRows = 0;

            productRows.forEach(function (row) {
                const productName = row.querySelector('.product-name').textContent.toLowerCase();
                const matches = productName.includes(searchText);
                row.hidden = !matches;

                if (matches) visibleRows++;
            });

            noResultsMessage.hidden = visibleRows > 0;
        });
    </script>
}
